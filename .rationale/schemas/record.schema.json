{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rationale.dev/schemas/record.schema.json",
  "title": "Record",
  "description": "Una decisión, restricción, riesgo o excepción consolidada. Corresponde a src/storage.rs::Record. vNext: el canon se mantiene solo — un candidato que pasa el gate de captura se vuelve Record con authority 'normal'; solo una persona lo fija ('pinned'). approvals conserva la historia de la era de aprobaciones.",
  "type": "object",
  "required": ["id", "kind", "severity", "statement"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$",
      "description": "Ej. 'constraint.no-global-admin-for-staff'."
    },
    "project_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["constraint", "decision", "risk", "exception"]
    },
    "title": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "scope": { "type": "string", "default": "project" },
    "subject": {
      "type": "object",
      "description": "Referencia embebida al Subject (v0.5 §27) — validada contra el canon real en .rationale/subjects/ por subjects::resolve_by_id_or_alias.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "La afirmación normativa exacta."
    },
    "constraint_expression": {
      "type": "object",
      "description": "Representación declarativa opcional (v0.5 §11.2) — reduce ambigüedad frente a texto libre.",
      "properties": {
        "subject": { "type": "string" },
        "predicate": { "type": "string" },
        "object": { "type": "string" },
        "conditions": { "type": "array" }
      }
    },
    "rationale": {
      "type": "string",
      "description": "El motivo, separado de la afirmación normativa misma."
    },
    "novelty_reason": {
      "type": "object",
      "required": ["contrasted_subject", "difference_kind", "difference", "evidence"],
      "properties": {
        "contrasted_subject": { "type": "string", "minLength": 1 },
        "difference_kind": {
          "type": "string",
          "enum": ["behavior", "scope", "lifecycle", "authority", "invariant"]
        },
        "difference": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "epistemic_status": {
      "type": "string",
      "enum": ["observed", "stated", "corroborated", "inferred", "disputed", "unknown"],
      "default": "stated",
      "description": "Rationale_v0.5.md §10, §12.1. Nunca se asume 'observed' por defecto — eso implicaría verificación mecánica que no ocurrió."
    },
    "authority": {
      "type": "string",
      "enum": ["normal", "pinned"],
      "default": "normal",
      "description": "vNext. 'pinned' solo por decisión humana explícita (rationale pin o resolución de conflicto); un agente nunca lo otorga. Ausente = normal."
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ids de Records que este reemplaza explícitamente. La precedencia nunca se infiere del orden de escritura ni de SHAs de Git; reemplazar un Record pinned exige resolver un conflicto."
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["active", "superseded", "revoked", "disputed"] },
        "events": { "type": "array", "items": { "type": "object" } }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["agent_asserted", "human_stated", "migrated"],
          "description": "vNext. Ausente = migrated (escrito antes de vNext). Nunca 'structural': lo observado en el grafo es evidencia, no memoria causal."
        },
        "client": { "type": "string" },
        "client_source": { "type": "string", "enum": ["flag", "mcp-client-info", "cli", "unknown"] },
        "operation_id": { "type": "string" },
        "session_id": { "type": "string" },
        "asserted_at": { "type": "string", "format": "date-time" },
        "created_by": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["agent", "human"] },
            "actor": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "approvals": {
      "type": "array",
      "default": [],
      "items": { "$ref": "approval.schema.json" }
    },
    "binding_declarations": {
      "type": "array",
      "default": [],
      "items": { "$ref": "binding.schema.json" }
    },
    "evidence": {
      "type": "array",
      "default": [],
      "items": { "$ref": "evidence.schema.json" }
    },
    "bound_revision": {
      "type": "string",
      "description": "SHA de Git en el que los bindings de este Record fueron declarados válidos. ADR-0006: comparado siempre contra Git real, nunca contra una señal del proveedor estructural."
    },
    "applicability_policy": {
      "type": "object",
      "properties": {
        "superseded_by": { "type": ["string", "null"] },
        "review_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context_policy": {
      "type": "object",
      "properties": {
        "priority": { "type": "string" },
        "always_include": { "type": "array", "items": { "type": "string" } },
        "max_default_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "sensitivity": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "security"]
        },
        "visibility": {
          "type": "string",
          "enum": ["repository", "local", "restricted"]
        }
      }
    }
  }
}
