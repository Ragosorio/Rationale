---
import { getCollection, render } from "astro:content";
import ArchitectureDiagram from "../../../components/ArchitectureDiagram.astro";
import LoopDiagram from "../../../components/LoopDiagram.astro";
import SubgraphDiagram from "../../../components/SubgraphDiagram.astro";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import masterPrompt from "../../../../../docs/prompt-master.md?raw";
import masterPromptEs from "../../../../../docs/prompt-master.es.md?raw";

export async function getStaticPaths() {
  const allEntries = await getCollection("docs");
  const entries = allEntries.filter((entry) => entry.data.lang === "es").sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      entries,
      previous: index > 0 ? entries[index - 1] : undefined,
      next: index < entries.length - 1 ? entries[index + 1] : undefined,
    },
  }));
}

const { entry, entries, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
// Los diagramas son componentes compartidos con la landing: se dibujan una vez.
const leadFigures: Record<string, typeof LoopDiagram> = {
  architecture: ArchitectureDiagram,
  workflow: LoopDiagram,
  "control-room": SubgraphDiagram,
};
const LeadFigure = leadFigures[entry.data.slug];
---

<DocsLayout
  lang="es"
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.data.slug}
  entries={entries}
  headings={headings}
  previous={previous}
  next={next}
>
  {LeadFigure && <div slot="lead" class="docs-lead-figure"><LeadFigure lang="es" /></div>}
  <Content />
  {entry.data.slug === "prompt-master" && <div class="docs-prompt-block">
    <div class="docs-prompt-toolbar"><span>Pegar al inicio de cada conversación</span><button type="button" data-docs-copy data-copy-value={masterPromptEs.trim()}>Copiar prompt</button></div>
    <pre><code>{masterPromptEs.trim()}</code></pre>
  </div>}
</DocsLayout>
