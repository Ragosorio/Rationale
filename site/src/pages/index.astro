                <span class="eyebrow" data-i18n="docsStart">Start</span><span><strong class="block text-lg"> <span data-i18n="docsQuickstart">Five-minute quickstart</span> <span aria-hidden="true" class="text-[var(--signal-strong)]">↗</span></strong><span class="mt-1 block text-sm text-[var(--muted)]" data-i18n="docsQuickstartBody">Install, initialize a project, inspect health and run the first preflight.</span></span><span class="hidden font-mono text-xs text-[var(--muted)] sm:block">01</span>
              </a>
              <a class="group grid gap-3 py-5 sm:grid-cols-[7rem_1fr_auto] sm:items-center sm:gap-5" href={docs.architecture}>
                <span class="eyebrow" data-i18n="docsUnderstand">Understand</span><span><strong class="block text-lg"><span data-i18n="docsArchitecture">Factual architecture</span> <span aria-hidden="true" class="text-[var(--signal-strong)]">↗</span></strong><span class="mt-1 block text-sm text-[var(--muted)]" data-i18n="docsArchitectureBody">See the real modules and the prepare → capture → review flow.</span></span><span class="hidden font-mono text-xs text-[var(--muted)] sm:block">02</span>
              </a>
              <a class="group grid gap-3 py-5 sm:grid-cols-[7rem_1fr_auto] sm:items-center sm:gap-5" href={docs.agents}>
