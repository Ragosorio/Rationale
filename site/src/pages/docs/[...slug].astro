---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import masterPrompt from "../../../../docs/prompt-master.md?raw";
import masterPromptEs from "../../../../docs/prompt-master.es.md?raw";

export async function getStaticPaths() {
  const allEntries = await getCollection("docs");
  const entries = allEntries.filter((entry) => entry.data.lang === "en").sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      entries,
      previous: index > 0 ? entries[index - 1] : undefined,
      next: index < entries.length - 1 ? entries[index + 1] : undefined,
    },
  }));
}

const { entry, entries, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  lang="en"
  title={entry.data.title}
  description={entry.data.description}
  slug={entry.data.slug}
  entries={entries}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
  {entry.data.slug === "prompt-master" && <div class="docs-prompt-block">
    <div class="docs-prompt-toolbar"><span>Paste at the start of each conversation</span><button type="button" data-docs-copy data-copy-value={masterPrompt.trim()}>Copy prompt</button></div>
    <pre><code>{masterPrompt.trim()}</code></pre>
  </div>}
</DocsLayout>
