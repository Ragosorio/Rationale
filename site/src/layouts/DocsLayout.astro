---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import RMark from "../components/RMark.astro";
import { DOC_GROUPS, docHref, docsRoot, homeHref } from "../lib/docs";

interface DocEntry {
  data: {
    lang: "en" | "es";
    slug: string;
    title: string;
    description: string;
    section: string;
    order: number;
  };
}

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  slug?: string;
  entries: DocEntry[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
  previous?: DocEntry;
  next?: DocEntry;
}

const { lang, title, description, slug = "", entries, headings = [], previous, next } = Astro.props;
const isSpanish = lang === "es";
const languageHref = slug ? (isSpanish ? docHref("en", slug) : docHref("es", slug)) : (isSpanish ? "/docs" : "/es/docs");
const languageLabel = isSpanish ? "EN" : "ES";
const languageAria = isSpanish ? "Read in English" : "Leer en español";
const entryBySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04060a" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`Rationale · ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{`${title} · Rationale`}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado para no parpadear.
      try {
        if (localStorage.getItem("rationale-theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only fixed left-4 top-4 z-50 bg-[var(--signal)] px-4 py-3 text-[var(--canvas)] focus:not-sr-only" href="#docs-main">{isSpanish ? "Saltar al contenido" : "Skip to content"}</a>
    <div class="docs-frame">
      <header class="docs-header">
        <div class="docs-header-inner">
          <a class="docs-brand" href={homeHref(lang)} aria-label={isSpanish ? "Inicio de Rationale" : "Rationale home"}>
            <RMark size={28} />
            <span><strong>Rationale</strong><small>{isSpanish ? "Documentación" : "Documentation"}</small></span>
          </a>
          <nav class="docs-header-actions" aria-label={isSpanish ? "Acciones del sitio" : "Site actions"}>
            <a href={docsRoot(lang)} class="docs-action">Docs</a>
            <a href={languageHref} class="docs-action" hreflang={isSpanish ? "en" : "es"} aria-label={languageAria}>{languageLabel}</a>
            <button class="docs-action" type="button" data-docs-theme-toggle aria-label={isSpanish ? "Tema oscuro" : "Dark theme"} aria-pressed="true">
              <Icon name="sun" class="theme-to-light" />
              <Icon name="moon" class="theme-to-dark" />
            </button>
            <a class="docs-action docs-github" href="https://github.com/Ragosorio/Rationale" target="_blank" rel="noreferrer" aria-label={isSpanish ? "Rationale en GitHub" : "Rationale on GitHub"}><span>GitHub</span><Icon name="external" /></a>
          </nav>
        </div>
      </header>

      <div class="docs-layout">
        <aside class="docs-sidebar" aria-label={isSpanish ? "Navegación de documentación" : "Documentation navigation"}>
          {DOC_GROUPS.map((group) => (
            <div class="docs-nav-group">
              <p class="docs-nav-label">{isSpanish ? group.es : group.en}</p>
              <nav>
                {group.slugs.map((itemSlug) => {
                  const entry = entryBySlug.get(itemSlug);
                  return entry ? <a class:list={["docs-nav-link", { active: itemSlug === slug }]} href={docHref(lang, itemSlug)} aria-current={itemSlug === slug ? "page" : undefined}>{entry.data.title}</a> : null;
                })}
              </nav>
            </div>
          ))}
        </aside>

        <main class="docs-main" id="docs-main">
          <nav class="docs-breadcrumbs" aria-label={isSpanish ? "Migas de pan" : "Breadcrumbs"}>
            <a href={homeHref(lang)}>Rationale</a><span aria-hidden="true">/</span><a href={docsRoot(lang)}>{isSpanish ? "Documentación" : "Documentation"}</a>{slug && <><span aria-hidden="true">/</span><span>{title}</span></>}
          </nav>
          <div class="docs-content-grid">
            <article class="docs-prose">
              <header class="docs-article-header">
                <h1>{title}</h1>
                <p class="docs-lede">{description}</p>
              </header>
              <slot name="lead" />
              <slot />
              {(previous || next) && <nav class="docs-pager" aria-label={isSpanish ? "Paginación" : "Pagination"}>
                {previous ? <a href={docHref(lang, previous.data.slug)}><small>{isSpanish ? "Anterior" : "Previous"}</small><strong>{previous.data.title}</strong></a> : <span></span>}
                {next ? <a class="next" href={docHref(lang, next.data.slug)}><small>{isSpanish ? "Siguiente" : "Next"}</small><strong>{next.data.title}</strong></a> : <span></span>}
              </nav>}
            </article>
            {headings.length > 0 && <aside class="docs-toc" aria-label={isSpanish ? "En esta página" : "On this page"}>
              <p class="docs-nav-label">{isSpanish ? "En esta página" : "On this page"}</p>
              {headings.filter((heading) => heading.depth <= 3).map((heading) => <a class:list={[{ nested: heading.depth === 3 }]} href={`#${heading.slug}`}>{heading.text}</a>)}
            </aside>}
          </div>
        </main>
      </div>

      <footer class="docs-footer">
        <span>{isSpanish ? "Tu repo. Tu proceso. Tu contexto." : "Your repo. Your process. Your context."}</span>
        <a href={homeHref(lang)}>{isSpanish ? "Volver al inicio" : "Back to the home page"}</a>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector("[data-docs-theme-toggle]");
      let saved = null;
      try {
        saved = window.localStorage.getItem("rationale-theme");
      } catch {
        // Sin almacenamiento, el tema por defecto sigue siendo válido.
      }
      // Oscuro por defecto, como la landing y el Control Room; el toggle recuerda la elección.
      const setTheme = (theme) => {
        const selected = theme === "light" ? "light" : "dark";
        root.dataset.theme = selected;
        try {
          window.localStorage.setItem("rationale-theme", selected);
        } catch {
          // El tema aplica igual aunque no se pueda recordar.
        }
        toggle?.setAttribute("aria-pressed", String(selected === "dark"));
      };
      setTheme(saved || "dark");
      toggle?.addEventListener("click", () => setTheme(root.dataset.theme === "dark" ? "light" : "dark"));
      document.querySelectorAll("[data-docs-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const original = button.textContent;
          try {
            await navigator.clipboard.writeText(button.dataset.copyValue || "");
            button.textContent = root.lang === "es" ? "Copiado" : "Copied";
          } catch {
            button.textContent = root.lang === "es" ? "Selecciona y copia" : "Select and copy";
          }
          window.setTimeout(() => { button.textContent = original; }, 1800);
        });
      });
    </script>
  </body>
</html>
