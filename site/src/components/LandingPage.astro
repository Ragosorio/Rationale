---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/landing.css";
import { landingCopy } from "../lib/landing";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
import Icon from "./Icon.astro";
import LoopDiagram from "./LoopDiagram.astro";
import RMark from "./RMark.astro";
import SubgraphDiagram from "./SubgraphDiagram.astro";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const t = landingCopy[lang];
const isSpanish = lang === "es";

const repo = "https://github.com/Ragosorio/Rationale";
const docsBase = isSpanish ? "/es/docs/" : "/docs/";
const docs = {
  root: docsBase,
  quickstart: `${docsBase}quickstart`,
  skill: `${docsBase}skill`,
  agents: `${docsBase}agents-and-mcp`,
  evidence: `${docsBase}evidence`,
  limits: `${docsBase}limits`,
  controlRoom: `${docsBase}control-room`,
  architecture: `${docsBase}architecture`,
};
const home = isSpanish ? "/es/" : "/";
const alternateHome = isSpanish ? "/" : "/es/";
const alternateLabel = isSpanish ? "EN" : "ES";
const pageTitle = isSpanish
  ? "Rationale 1.0 · Tus agentes olvidan el porqué. Rationale lo recuerda."
  : "Rationale 1.0 · Your agents forget why. Rationale remembers.";
const pageDescription = isSpanish
  ? "Memoria causal local para agentes de código: contexto antes del cambio, memoria durable después, y las reglas que fijas fuera del alcance de cualquier agente."
  : "Local causal memory for coding agents: context before the change, durable memory after it, and the rules you pin out of any agent's reach.";
const installCommand = `curl --proto '=https' --tlsv1.2 -LsSf ${repo}/releases/latest/download/rationale-installer.sh | sh`;
const codebaseMemoryUrl = "https://github.com/DeusData/codebase-memory-mcp";
const codebaseMemoryCommand = "curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh | bash";
const skillCommand = "npx skills add Ragosorio/Rationale";

/** Texto con `código` en línea → segmentos para renderizar. */
const inline = (text: string) =>
  text.split("`").map((part, index) => ({ code: index % 2 === 1, part }));
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04060a" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rationale" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado para no parpadear.
      try {
        if (localStorage.getItem("rationale-theme") === "light") document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only fixed left-4 top-4 z-50 bg-[var(--signal)] px-4 py-3 text-[var(--canvas)] focus:not-sr-only" href="#main">{t.skip}</a>

    <div class="l-page">
      <header class="l-header">
        <div class="l-container l-header-inner">
          <a href={home} class="l-brand" aria-label={isSpanish ? "Inicio de Rationale" : "Rationale home"}>
            <RMark size={28} />
            <span class="l-brand-text"><strong>Rationale</strong><small>{t.brandTagline}</small></span>
          </a>

          <nav class="l-nav" aria-label={isSpanish ? "Secciones de la página" : "Page sections"}>
            <a href="#loop">{t.navLoop}</a>
            <a href="#quick-start">{t.navStart}</a>
            <a href="#skill">{t.navSkill}</a>
            <a href="#control-room">{t.navControlRoom}</a>
            <a href={docs.root}>{t.navDocs}</a>
          </nav>

          <div class="l-actions">
            <a class="l-action" href={repo} target="_blank" rel="noreferrer" aria-label={t.githubLabel}>
              <span class="l-action-label">GitHub</span>
              <Icon name="star" />
              <span class="l-stars" data-github-stars hidden></span>
            </a>
            <a class="l-action" href={alternateHome} hreflang={isSpanish ? "en" : "es"} aria-label={t.languageLabel}>{alternateLabel}</a>
            <button class="l-action" type="button" data-theme-toggle aria-label={t.themeLabel} aria-pressed="true">
              <Icon name="sun" class="theme-to-light" />
              <Icon name="moon" class="theme-to-dark" />
            </button>
          </div>
        </div>
      </header>

      <main id="main">
        <section class="l-container l-hero" aria-labelledby="hero-title">
          <div>
            <h1 id="hero-title" class="l-h1"><span>{t.heroTitleA}</span><span class="l-h1-accent">{t.heroTitleB}</span></h1>
            <p class="l-hero-body">{t.heroBody}</p>
            <div class="l-hero-cta">
              <a class="l-btn l-btn-primary" href="#quick-start">{t.startCta}</a>
              <a class="l-btn" href={docs.quickstart}>{t.quickstartCta}</a>
            </div>
            <div class="l-command l-hero-command">
              <pre>{installCommand}</pre>
              <button type="button" data-copy-value={installCommand}><span data-copy-status>{t.copyLabel}</span></button>
            </div>
            <p class="l-hero-meta">{t.heroMeta}</p>
          </div>
          <div class="l-hero-figure">
            <LoopDiagram lang={lang} />
          </div>
        </section>

        <section id="problem" class="l-section" aria-labelledby="problem-title">
          <div class="l-container l-split">
            <div>
              <h2 id="problem-title" class="l-h2">{t.problemTitle}</h2>
              <p class="l-lede">{t.problemBody}</p>
            </div>
            <div>
              <div class="l-transcript">
                <div class="l-transcript-row">
                  <span class="l-transcript-who">{t.problemMonday}</span>
                  <p class="l-transcript-said">{t.problemQuote}</p>
                </div>
                <div class="l-transcript-row">
                  <span class="l-transcript-who">{t.problemThursday}</span>
                  <div class="l-diff">
                    <span class="l-diff-msg">{t.problemCommit}</span>
                    <del>- if payment.reached_bank {"{"} return {"}"}</del>
                  </div>
                </div>
              </div>
              <p class="l-answer">{t.problemAnswer}</p>
            </div>
          </div>
        </section>

        <section id="loop" class="l-section" aria-labelledby="loop-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="loop-title" class="l-h2">{t.loopTitle}</h2>
              <p class="l-lede">{t.loopBody}</p>
            </div>
            <ol class="l-ledger">
              {t.loopSteps.map((step, index) => (
                <li class:list={[{ "is-human": index === t.loopSteps.length - 1 }]}>
                  <span class="l-ledger-num">{String(index + 1).padStart(2, "0")}</span>
                  <div class="l-ledger-name">
                    <h3>{step.title}</h3>
                    {step.code ? <code>{step.tool}</code> : <span class="l-ledger-tool">{step.tool}</span>}
                  </div>
                  <p>{step.body}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section id="quick-start" class="l-section" aria-labelledby="quick-start-title">
          <div class="l-container l-install">
            <div>
              <h2 id="quick-start-title" class="l-h2">{t.startTitle}</h2>
              <p class="l-lede">{inline(t.startBody).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
            </div>
            <ol class="l-steps">
              <li>
                <p class="l-step-label"><span class="l-step-num">1</span><span>{t.startCompanionA} <a class="l-link" href={codebaseMemoryUrl} target="_blank" rel="noreferrer">Codebase Memory</a>{t.startCompanionB}</span></p>
                <div class="l-command"><pre>{codebaseMemoryCommand}</pre><button type="button" data-copy-value={codebaseMemoryCommand}><span data-copy-status>{t.copyLabel}</span></button></div>
              </li>
              <li>
                <p class="l-step-label"><span class="l-step-num">2</span><span>{t.startInstall}</span></p>
                <div class="l-command"><pre>{installCommand}</pre><button type="button" data-copy-value={installCommand}><span data-copy-status>{t.copyLabel}</span></button></div>
                <p class="l-install-note">{t.startInstallNote}</p>
              </li>
              <li>
                <p class="l-step-label"><span class="l-step-num">3</span><span>{t.startInit}</span></p>
                <div class="l-command"><pre>rationale init</pre><button type="button" data-copy-value="rationale init"><span data-copy-status>{t.copyLabel}</span></button></div>
                <p class="l-install-note">{inline(t.startInitNote).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
              </li>
              <li>
                <p class="l-step-label"><span class="l-step-num">4</span><span>{t.startRestart}</span></p>
                <p class="l-install-note">{inline(t.startRestartNote).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
              </li>
              <li>
                <p class="l-step-label"><span class="l-step-num">5</span><span>{t.startAsk}</span></p>
                <p class="l-step-quote">{t.startAskQuote}</p>
                <p class="l-install-note">{t.startAskNote}</p>
              </li>
              <li>
                <p class="l-step-label"><span class="l-step-num">6</span><span>{t.startWatch}</span></p>
                <div class="l-command"><pre>rationale ui</pre><button type="button" data-copy-value="rationale ui"><span data-copy-status>{t.copyLabel}</span></button></div>
                <div class="l-command"><pre>rationale pin &lt;record-id&gt;</pre><button type="button" data-copy-value="rationale pin <record-id>"><span data-copy-status>{t.copyLabel}</span></button></div>
              </li>
              <li>
                <p class="l-install-note"><a class="l-link" href={docs.quickstart}>{t.startWindows}</a></p>
              </li>
            </ol>
          </div>
        </section>

        <section id="skill" class="l-section" aria-labelledby="skill-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="skill-title" class="l-h2">{t.skillTitle}</h2>
              <p class="l-lede">{inline(t.skillBody).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
            </div>
            <div class="l-split">
              <dl class="l-defs">
                {t.skillFeatures.map((feature) => (
                  <div>
                    <dt>{feature.title}</dt>
                    <dd>{inline(feature.body).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</dd>
                  </div>
                ))}
              </dl>
              <div>
                <div class="l-table-wrap">
                  <table class="l-states l-ops">
                    <thead>
                      <tr>
                        <th scope="col">{t.skillOpHead}</th>
                        <th scope="col">{t.skillWhenHead}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {t.skillOps.map((item) => (
                        <tr>
                          <th scope="row"><code>{item.op}</code></th>
                          <td>{inline(item.when).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div class="l-skill-install">
                  <p class="l-step-label">{t.skillInstallLabel}</p>
                  <div class="l-command"><pre>{skillCommand}</pre><button type="button" data-copy-value={skillCommand}><span data-copy-status>{t.copyLabel}</span></button></div>
                  <p class="l-install-note">{inline(t.skillInstallNote).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
                </div>
              </div>
            </div>
            <p class="l-after"><span></span><a class="l-link" href={docs.skill}>{t.skillDocs}</a></p>
          </div>
        </section>

        <section id="packet" class="l-section" aria-labelledby="packet-title">
          <div class="l-container l-split">
            <div>
              <h2 id="packet-title" class="l-h2">{t.packetTitle}</h2>
              <p class="l-lede">{t.packetBody}</p>
              <ul class="l-points">
                {t.packetPoints.map((point) => <li>{point}</li>)}
              </ul>
            </div>
            <figure class="l-code">
              <figcaption class="l-code-bar"><b>{t.packetFile}</b><span>{t.packetNote}</span></figcaption>
<pre class="l-json"><span class="m">{"{"}</span>
  <span class="k">"operation_id"</span>: <span class="s">"op_7f3c…"</span>,
  <span class="k">"critical_constraints"</span>: [{"{"}
    <span class="k">"id"</span>: <span class="s">"constraint.payments-idempotent"</span>,
    <span class="k">"authority"</span>: <span class="p">"pinned"</span>, <span class="k">"provenance"</span>: <span class="s">"human_stated"</span>
  {"}"}],
  <span class="k">"decisions"</span>: [{"{"}
    <span class="k">"id"</span>: <span class="s">"decision.charge-after-reservation"</span>,
    <span class="k">"authority"</span>: <span class="s">"normal"</span>, <span class="k">"provenance"</span>: <span class="s">"agent_asserted"</span>
  {"}"}],
  <span class="k">"relationships"</span>: [
    {"{"} <span class="k">"edge"</span>: <span class="s">"charge → bank_client"</span>, <span class="k">"state"</span>: <span class="o">"observed"</span> {"}"},
    {"{"} <span class="k">"edge"</span>: <span class="s">"retry_worker → charge"</span>, <span class="k">"state"</span>: <span class="w">"indirect"</span> {"}"}
  ],
  <span class="k">"structure"</span>: {"{"} <span class="k">"nodes"</span>: <span class="s">"12 / 52"</span>, <span class="k">"edges"</span>: <span class="s">"11 / 51"</span> {"}"},
  <span class="k">"estimated_tokens"</span>: <span class="s">1707</span>, <span class="m">// ≤ 2400</span>
  <span class="k">"known_unknowns"</span>: [<span class="s">"refunds → charge: orphaned"</span>]
<span class="m">{"}"}</span></pre>
            </figure>
          </div>
        </section>

        <section id="control-room" class="l-section" aria-labelledby="room-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="room-title" class="l-h2">{t.roomTitle}</h2>
              <p class="l-lede">{inline(t.roomBody).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
            </div>
            <div class="l-room-figure">
              <SubgraphDiagram lang={lang} />
            </div>
            <dl class="l-defs l-defs-2">
              {t.roomFeatures.map((feature) => (
                <div><dt>{feature.title}</dt><dd>{feature.body}</dd></div>
              ))}
            </dl>
            <p class="l-after"><span>{t.roomSafety}</span><a class="l-link" href={docs.controlRoom}>{t.roomDocs}</a></p>
          </div>
        </section>

        <section id="memory" class="l-section" aria-labelledby="memory-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="memory-title" class="l-h2">{t.memoryTitle}</h2>
              <p class="l-lede">{t.memoryBody}</p>
            </div>
            <div class="l-memory">
              <dl class="l-defs">
                {t.memoryTerms.map((item) => (
                  <div>
                    <dt><span>{item.title}</span><code class:list={[{ "is-causal": item.term === "pinned" }]}>{item.term}</code></dt>
                    <dd>{item.body}</dd>
                  </div>
                ))}
              </dl>
              <div class="l-terminal">
                <div class="l-terminal-lines">
                  <div class="l-terminal-line"><span><span class="prompt">$</span> rationale pin constraint.payments-idempotent</span><span class="cmt">{t.commentPin}</span></div>
                  <div class="l-terminal-line"><span><span class="prompt">$</span> rationale conflicts</span><span class="cmt">{t.commentConflicts}</span></div>
                  <div class="l-terminal-line"><span><span class="prompt">$</span> rationale resolve <span class="amber">conflict_…</span> keep-pinned</span><span class="cmt">{t.commentResolve}</span></div>
                </div>
                <p class="l-terminal-note">{t.memoryTerminalNote}</p>
              </div>
            </div>
          </div>
        </section>

        <section id="relationships" class="l-section" aria-labelledby="edges-title">
          <div class="l-container l-split">
            <div>
              <h2 id="edges-title" class="l-h2">{t.edgesTitle}</h2>
              <p class="l-lede">{t.edgesBody}</p>
            </div>
            <div class="l-table-wrap">
              <table class="l-states">
                <thead>
                  <tr>
                    <th scope="col">{t.edgesStateHead}</th>
                    <th scope="col"><span class="sr-only">{t.edgesSampleHead}</span></th>
                    <th scope="col">{t.edgesMeaningHead}</th>
                  </tr>
                </thead>
                <tbody>
                  {t.edgeStates.map((item) => (
                    <tr>
                      <th scope="row"><code>{item.state}</code></th>
                      <td class="l-state-sample"><svg viewBox="0 0 88 12" aria-hidden="true"><line class={`l-state-line is-${item.state}`} x1="2" y1="6" x2="86" y2="6" /></svg></td>
                      <td>{item.body}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="architecture" class="l-section" aria-labelledby="systems-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="systems-title" class="l-h2">{t.systemsTitle}</h2>
              <p class="l-lede">{t.systemsBody}</p>
            </div>
            <ArchitectureDiagram lang={lang} />
            <p class="l-after"><span></span><a class="l-link" href={docs.architecture}>{t.systemsDocs}</a></p>
          </div>
        </section>

        <section id="agents" class="l-section" aria-labelledby="agents-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="agents-title" class="l-h2">{t.agentsTitle}</h2>
              <p class="l-lede">{inline(t.agentsBody).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
            </div>
            <div class="l-agents">
              <article class="l-agent">
                <p class="l-agent-name">Claude Code</p>
                <h3>{t.claudeTitle}</h3>
                <ul class="l-skill-list">
                  <li><code>/rationale [operation]</code></li>
                  <li><code>/rationale-preflight &lt;target&gt; &lt;intent&gt;</code></li>
                  <li><code>/rationale-explain &lt;target&gt;</code></li>
                  <li><code>/rationale-capture [statement]</code></li>
                  <li><code class="is-human">/rationale-conflicts</code></li>
                  <li><code>/rationale-health</code></li>
                </ul>
                <p class="l-agent-note">{inline(t.claudeNote).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
              </article>
              <article class="l-agent">
                <p class="l-agent-name">Codex</p>
                <h3>{t.codexTitle}</h3>
                <ul class="l-phrases">
                  <li>“{inline(t.codexPrepare).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}”</li>
                  <li>“{inline(t.codexExplain).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}”</li>
                  <li>“{inline(t.codexCapture).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}”</li>
                  <li>“{inline(t.codexHealth).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}”</li>
                </ul>
                <p class="l-agent-note">{inline(t.codexNote).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
              </article>
              <article class="l-agent">
                <p class="l-agent-name">Cursor</p>
                <h3>{t.cursorTitle}</h3>
                <p class="l-agent-body">{inline(t.cursorBody).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</p>
                <p class="l-agent-note"><a class="l-link" href={docs.agents}>{t.agentsDocs}</a></p>
              </article>
            </div>
          </div>
        </section>

        <section id="trust" class="l-section" aria-labelledby="trust-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="trust-title" class="l-h2">{t.trustTitle}</h2>
            </div>
            <dl class="l-defs l-defs-2">
              {t.trustItems.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{inline(item.body).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</dd>
                </div>
              ))}
            </dl>
            <p class="l-spec">{t.trustSpec}</p>
          </div>
        </section>

        <section id="release" class="l-section" aria-labelledby="release-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="release-title" class="l-h2">{t.releaseTitle}</h2>
              <p class="l-lede">{t.releaseBody}</p>
            </div>
            <div class="l-release">
              <div>
                <h3>{t.releaseVerifiedLabel}<small>v1.0.0</small></h3>
                <ul class="l-checks">{t.releaseVerified.map((item) => <li>{item}</li>)}</ul>
                <a class="l-link" href={docs.evidence}>{t.releaseEvidence}</a>
              </div>
              <div>
                <h3>{t.releaseOpenLabel}</h3>
                <ul class="l-checks l-checks-open">{t.releaseOpen.map((item) => <li>{inline(item).map((seg) => (seg.code ? <code>{seg.part}</code> : seg.part))}</li>)}</ul>
                <a class="l-link" href={docs.limits}>{t.releaseLimits}</a>
              </div>
            </div>
          </div>
        </section>

        <section id="documentation" class="l-section" aria-labelledby="docs-title">
          <div class="l-container">
            <div class="l-section-head">
              <h2 id="docs-title" class="l-h2">{t.docsTitle}</h2>
            </div>
            <div class="l-docs">
              {t.docsCards.map((card) => (
                <a class="l-doc" href={`${docsBase}${card.slug}`}>
                  <strong>{card.title}</strong>
                  <small>{card.body}</small>
                </a>
              ))}
            </div>
          </div>
        </section>
      </main>

      <footer class="l-footer">
        <div class="l-container l-footer-inner">
          <div class="l-footer-brand">
            <RMark size={24} />
            <div><p>{t.footerLine}</p><p>{t.footerStatus}</p></div>
          </div>
          <nav aria-label={isSpanish ? "Navegación del pie" : "Footer navigation"}>
            <a href={docs.root}>{t.footerDocs}</a>
